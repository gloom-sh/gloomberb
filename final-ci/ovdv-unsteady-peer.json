          "line": 192,
          "text": "/** Until nothing in `scope` has changed for `quietMs`, at most `maxMs`. */"
        },
        {
          "line": 193,
          "text": "export async function settle(cdp: Cdp, scope: string, quietMs = 800, maxMs = 9_000): Promise<void> {"
        },
        {
          "line": 194,
          "text": "  await evaluate(cdp, `(() => { window.__changed = performance.now(); window.__settle?.disconnect(); const root = document.querySelector(${JSON.stringify(scope)}) ?? document.body; window.__settle = new MutationObserver(() => { window.__changed = performance.now(); }); window.__settle.observe(root, { subtree: true, childList: true, attributes: true, characterData: true }); })()`);"
        },
        {
          "line": 195,
          "text": "  const until = Date.now() + maxMs;"
        },
        {
          "line": 196,
          "text": "  while (Date.now() < until) {"
        },
        {
          "line": 197,
          "text": "    await sleep(200);"
        },
        {
          "line": 198,
          "text": "    if (await evaluate<number>(cdp, \"performance.now() - window.__changed\") >= quietMs) return;"
        }
      ]
