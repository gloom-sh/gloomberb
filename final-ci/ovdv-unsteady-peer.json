  "sourceLineEvidence": [
    {
      "path": "scripts/pane-chrome/ui-benchmark.ts",
      "blob": "1ec79fbad12a26fcd31a4b54dd78ab57fa0d7436",
      "selectedLines": [
        {
          "line": 98,
          "text": "  // A view that moved is pictured once more on each side: if two pictures of the same code"
        },
        {
          "line": 99,
          "text": "  // differ, the view is unsteady (a 3D surface's labels, a value read from the clock), not changed."
        },
        {
          "line": 100,
          "text": "  const moving = (await changes(join(options.out, \"before\"), join(options.out, \"after\"))).filter(moved);"
        },
        {
          "line": 101,
          "text": "  const unsteady = new Set<string>();"
        },
        {
          "line": 102,
          "text": "  if (moving.length) {"
        },
        {
          "line": 103,
          "text": "    const only = [...new Set(moving.map((change) => change.view.split(\"--\")[0]!))].join(\",\");"
        },
        {
          "line": 104,
          "text": "    for (const [side, root] of [[\"before\", base], [\"after\", head]] as const) {"
        },
        {
          "line": 105,
          "text": "      audit(`${side}-again`, root, { ...options, only });"
        },
        {
          "line": 106,
          "text": "      const twice = new Map((await changes(join(options.out, side), join(options.out, `${side}-again`))).map((change) => [change.view, change]));"
        },
        {
          "line": 107,
          "text": "      for (const change of moving) {"
        },
        {
          "line": 108,
          "text": "        const second = twice.get(change.view);"
        },
        {
          "line": 109,
          "text": "        // Drawn differently, or opened only once of the two times (a detail Enter opened while the root was still moving)."
        },
        {
          "line": 110,
          "text": "        if (second && moved(second)) unsteady.add(change.view);"
        },
        {
          "line": 111,
          "text": "      }"
        },
        {
          "line": 112,
          "text": "    }"
        },
        {
          "line": 113,
          "text": "  }"
        },
        {
          "line": 114,
          "text": "  // Written last: a shard with this file finished."
        },
        {
          "line": 115,
          "text": "  await Bun.write(join(options.out, \"unsteady.json\"), JSON.stringify([...unsteady]));"
        },
        {
          "line": 116,
          "text": "  // The builds are large and each side's results and pictures are what the report reads."
        },
        {
          "line": 117,
          "text": "  await rm(join(options.out, \"web-before\"), { recursive: true, force: true });"
        },
        {
          "line": 118,
          "text": "  await rm(join(options.out, \"web-after\"), { recursive: true, force: true });"
        },
        {
          "line": 119,
          "text": "  await rm(join(options.out, \"before-again\"), { recursive: true, force: true });"
        },
        {
          "line": 120,
          "text": "  await rm(join(options.out, \"after-again\"), { recursive: true, force: true });"
        }
      ]
    },
