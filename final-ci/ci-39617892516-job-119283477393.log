2026-10-21T15:05:37.3853703Z 
2026-10-21T15:05:37.3853830Z act(() => {
2026-10-21T15:05:37.3854176Z   /* fire events that update state */
2026-10-21T15:05:37.3854591Z });
2026-10-21T15:05:37.3855093Z /* assert on the output */
2026-10-21T15:05:37.3855686Z 
2026-10-21T15:05:37.3856406Z This ensures that you're testing the behavior the user would see in the browser. Learn more at https://react.dev/link/wrap-tests-with-act
