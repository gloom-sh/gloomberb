{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gloom",
  "mainBinaryName": "Gloom",
  "version": "0.19.2",
  "identifier": "sh.gloom.tauri-spike",
  "build": {
    "frontendDist": "../../dist/electrobun-view"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/bun"
    ],
    "resources": {
      "../backend/": "backend/"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
