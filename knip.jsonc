{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "bin/gloomberb",
    "electrobun.config.ts",
    "scripts/install-electrobun-tui-shim.ts",
    "src/cli/entry.ts",
    "src/renderers/electrobun/bun/index.ts",
    "src/renderers/electrobun/bun/tui-entry.ts",
    "src/renderers/electrobun/view/main.tsx",
    "src/renderers/electrobun/view/app-services.ts",
    "src/renderers/electrobun/view/cli-pane-shot-entry.tsx",
    "src/renderers/electrobun/view/notes-files.ts",
    "src/renderers/electrobun/view/native-stubs/**/*.ts",
    "src/renderers/browser/main.tsx",
    "src/renderers/share/main.tsx"
  ],
  "project": [
    "scripts/**/*.ts",
    "src/**/*.{ts,tsx}"
  ],
  "ignoreDependencies": [
    // Run by path from node_modules to build and embed the Windows app icon.
    "png-to-ico",
    "rcedit",
    // electrobun ships TypeScript source that imports three, which has no types of its own.
    "@types/three",
    // Loaded by package name through WEB_BUNDLED_PLUGIN_PACKAGES in src/plugins/web-bundled.ts.
    "gloom-fear-greed",
    "gloom-ipo-calendar",
    "gloom-market-halts",
    "gloom-market-heatmap",
    "gloom-polls",
    "gloom-prediction-markets"
  ]
}
