+// Where updates are fetched from when it is not the channel and baseUrl that
+// version.json names: a release whose files carry another prefix (`nightly-*`)
+// under its own URL. Only the URLs read it. The manifest is still checked
+// against the installed build's identity and channel, and the app data
+// folder and the "dev" check keep that channel too.
+let updateSource: { channel: string; baseUrl: string } | null = null;
+
+function updateSourceBaseUrl(info: LocalUpdateInfo): string {
+	return updateSource?.baseUrl ?? info.baseUrl;
+}
+
+/** The prefix of the source's files: `<channel>-<os>-<arch>`. */
+function updateSourcePrefix(
+	channel: BuildEnvironment,
+	os: SupportedOS,
+	arch: SupportedArch,
+): string {
+	if (!updateSource) return getPlatformPrefix(channel, os, arch);
+	return `${updateSource.channel}-${os}-${arch}`;
+}
+
+/**
+ * The manifest names its archive under the channel it was built for; a
+ * source that carries the files under its own prefix has it under that one.
+ */
+function updateSourceArtifactFile(manifest: UpdateManifestV1): string {
+	const built = `${manifest.channel}-`;
+	if (!updateSource || !manifest.artifact.file.startsWith(built)) {
+		return manifest.artifact.file;
+	}
+	return `${updateSource.channel}-${manifest.artifact.file.slice(built.length)}`;
+}
