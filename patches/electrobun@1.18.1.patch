+ * Where the running app goes while the new one moves in: `<app>.previous`, or,
+ * when an older one is still there and cannot be removed (a bundle another
+ * user owns), a name of its own, so a copy left behind once never blocks
+ * every later update. The app removes the copies it left at its next start.
+ */
+function updateAsidePath(appPath: string): string {
+	const previous = `${appPath}.previous`;
+	if (!statSync(previous, { throwIfNoEntry: false })) return previous;
+	try {
+		rmSync(previous, { recursive: true, force: true });
+	} catch (e) {
+		// Left for the next start to remove; this update takes another name.
+	}
+	if (!statSync(previous, { throwIfNoEntry: false })) return previous;
+	for (let attempt = 0; ; attempt += 1) {
+		const unique = `${previous}-${Date.now().toString(36)}${attempt ? `-${attempt}` : ""}`;
+		if (!statSync(unique, { throwIfNoEntry: false })) return unique;
+	}
