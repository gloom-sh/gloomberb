{
  "name": "gloomberb",
  "version": "0.18.4",
  "packageManager": "bun@1.3.11",
  "description": "Market research and portfolio tracker for the terminal",
  "module": "src/public/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/public/index.ts",
    "./types/plugin": "./src/types/plugin.ts",
    "./types/persistence": "./src/types/persistence.ts",
    "./ui": "./src/ui/index.tsx",
    "./components": "./src/components/index.ts",
    "./theme": "./src/theme/colors.ts",
    "./capabilities": "./src/capabilities/index.ts",
    "./utils": "./src/public/utils.ts",
    "./react": "./src/public/react.ts",
    "./test-support": "./src/public/test-support.ts",
    "./package.json": "./package.json",
    "./types/broker": "./src/types/broker.ts",
    "./types/config": "./src/types/config.ts",
    "./types/data-provider": "./src/types/data-provider.ts",
    "./types/financials": "./src/types/financials.ts",
    "./types/instrument": "./src/types/instrument.ts",
    "./types/ticker": "./src/types/ticker.ts",
    "./types/trading": "./src/types/trading.ts",
    "./time-series": "./src/public/time-series.ts",
    "./layout": "./src/public/layout.ts",
    "./market-data": "./src/public/market-data.ts",
    "./quotes": "./src/public/quotes.ts",
    "./tickers": "./src/public/tickers.ts",
    "./i18n": "./src/public/i18n.ts",
    "./remote": "./src/public/remote.ts",
    "./dialog": "./src/ui/dialog.tsx",
    "./broker": "./src/public/broker.ts"
  },
  "bin": {
    "gloom": "bin/gloom",
    "gloomberb": "bin/gloom"
  },
  "files": [
    "bin",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "!src/**/test-harness.tsx",
    "!src/**/fixtures/**",
    "!src/**/*.fixture.json",
    "!src/**/test-fixture*.ts",
    "!src/**/*.test-data.ts",
    "patches"
  ],
  "scripts": {
    "dev": "bun run --watch src/cli/entry.ts",
    "start": "bun src/cli/entry.ts",
    "build": "bun run scripts/build.ts",
    "build:all": "bun run scripts/build.ts --all",
    "desktop:view:build": "bun run scripts/build-electrobun-view.ts",
    "web:build": "bun run scripts/build-web.ts",
    "web:audit": "bun run web:build && bun run scripts/audit-web-bundle.ts",
    "cloudflare:dry-run": "bun run web:build && wrangler deploy --dry-run --env production",
    "desktop:dev": "bun run scripts/electrobun-dev.ts",
    "desktop:build": "electrobun build",
    "desktop:release": "electrobun build --env=stable",
    "desktop:release:windows": "electrobun build --env=stable --targets=win-x64",
    "docs:snapshot": "bun run scripts/update-docs-snapshot.ts",
    "plugins:manifest": "bun run scripts/generate-plugin-manifest.ts",
    "plugins:manifest:check": "bun run scripts/generate-plugin-manifest.ts --check",
    "plugins:registry:check": "bun run scripts/check-registry-plugins.ts",
    "web:proxy-hosts": "bun run scripts/generate-web-proxy-hosts.ts",
    "map:data": "bun run scripts/generate-world-map-data.ts",
    "glyphs:terminal": "bun run scripts/generate-terminal-glyphs.ts",
    "macro-releases:update": "bun run scripts/update-macro-releases.ts",
    "web:proxy-hosts:check": "bun run scripts/generate-web-proxy-hosts.ts --check",
    "typecheck": "bun run typecheck:opentui && bun run typecheck:dom && bun run typecheck:cloudflare && bun run typecheck:scripts && bun run typecheck:plugin-tests",
    "typecheck:opentui": "tsc --project tsconfig.opentui.json",
    "typecheck:dom": "tsc --project tsconfig.dom.json",
    "typecheck:cloudflare": "tsc --project tsconfig.cloudflare.json",
    "typecheck:scripts": "tsc --project tsconfig.scripts.json",
    "typecheck:plugin-tests": "tsc --project tsconfig.plugin-tests.json",
    "knip": "bunx knip@6.39.0",
    "test": "bun test",
    "benchmark:tui:navigation": "bun run scripts/benchmark-tui-navigation.ts",
    "benchmark:tui:compare": "bun run scripts/benchmark-tui-compare.ts",
    "benchmark:tui:memory": "bun run scripts/benchmark-tui-memory.ts",
    "benchmark:startup": "bun run scripts/benchmark-startup.ts",
    "check:pane-chrome": "bun run scripts/pane-chrome/checks.ts",
    "check:chat-mentions": "bun scripts/pane-chrome/chat-mentions.ts",
    "check:pane-screenshot": "bun run scripts/pane-chrome/screenshot.ts",
    "check:pane-rest": "bun run scripts/pane-chrome/rest-diff.ts",
    "check:table-resize": "bun run scripts/pane-chrome/table-resize.ts",
    "check:pane-layout": "bun run scripts/pane-chrome/layout-sweep.ts",
    "check:ui-tokens": "bun run scripts/pane-chrome/ui-tokens.ts",
    "ui:benchmark": "bun run scripts/pane-chrome/ui-benchmark.ts",
    "audit:ui": "bun run scripts/pane-chrome/ui-audit.ts",
    "check:call-player": "bun run scripts/pane-chrome/call-player.ts",
    "check:chart-axis-zoom": "bun run scripts/pane-chrome/chart-axis-zoom.ts",
    "check:chart-panel-layout": "bun run scripts/pane-chrome/chart-panel-layout.ts",
    "kit:page": "bun run scripts/pane-chrome/kit-page.ts",
    "audit:ui:compare": "bun run scripts/pane-chrome/ui-audit-compare.ts",
    "benchmark:pane-drag:compare": "bun run scripts/pane-chrome/frame-budget.ts",
    "test:global-upgrade": "bun run scripts/smoke-global-upgrade.ts",
    "release": "./scripts/release.sh"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gloom-sh/gloomberb"
  },
  "keywords": [
    "terminal",
    "tui",
    "stocks",
    "portfolio",
    "finance"
  ],
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "0.165.0",
    "electrobun": "^1.18.1",
    "gloom-polls": "github:gloom-sh/gloom-polls#dfd641e78984a6f579cae3be1c7d0b8d2c8a080c",
    "gloom-prediction-markets": "github:gloom-sh/gloom-prediction-markets#4a7163e4b9238eabb8271e9e22774d9d62e88c27",
    "happy-dom": "^20.11.1",
    "playwright-core": "1.60.0",
    "png-to-ico": "^2.1.8",
    "rcedit": "^4.0.1",
    "typescript": "^5.9.2",
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "@opentui/core": "^0.3.2",
    "@opentui/react": "^0.3.2",
    "@tanstack/react-virtual": "^3.14.2",
    "hls.js": "1.6.13",
    "jimp": "1.6.1",
    "qrcode-generator": "^2.0.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "web-tree-sitter": "0.25.10"
  },
  "patchedDependencies": {
    "@opentui/core@0.3.2": "patches/@opentui%2Fcore@0.3.2.patch",
    "electrobun@1.18.1": "patches/electrobun@1.18.1.patch",
    "react-reconciler@0.33.0": "patches/react-reconciler@0.33.0.patch"
  }
}
